# 심볼 레이블 생성 (3릴 × 3행)
sym_labels = []
import random
for col in range(3):
    col_labels = []
    for row in range(3):
        idx = random.randint(0, len(SYMBOLS)-1)
        sym, col_c = SYMBOLS[idx]
        lbl = label(
            pos=vector(reel_x[col], row_y[row], 1.2),
            text=sym, height=26,
            color=col_c, box=False
        )
        col_labels.append(lbl)
    sym_labels.append(col_labels)

# ── 게임 상태 변수 ─────────────────────────────────────
credit    = 100
win_total = 0
spinning  = False
spin_time = 0
spin_duration = 2.0   # 릴 회전 시간(초)
result    = [0, 0, 0]  # 각 릴의 최종 심볼 인덱스

# ── 당첨금 계산 함수 ───────────────────────────────────
def calc_prize(r):
    # r = [릴0중간심볼, 릴1중간심볼, 릴2중간심볼] 인덱스
    if r[0] == r[1] == r[2]:
        if r[0] == 0:   return 500  # 777 잭팟
        if r[0] == 1:   return 200  # ★★★
        if r[0] == 5:   return 100  # BAR BAR BAR
        return 50                   # 기타 트리플
    if r[0] == r[1] or r[1] == r[2]: return 10
    return 0

# ── 릴 업데이트 함수 ───────────────────────────────────
def update_reels(final=False):
    for col in range(3):
        for row in range(3):
            if final:
                # 최종 심볼 배치: 중간 행에 result 적용
                offset = row - 1
                idx = (result[col] + offset) % len(SYMBOLS)
            else:
                idx = random.randint(0, len(SYMBOLS)-1)
            sym, col_c = SYMBOLS[idx]
            sym_labels[col][row].text  = sym
            sym_labels[col][row].color = col_c

# ── SPIN 버튼 ──────────────────────────────────────────
spin_btn = box(
    pos=vector(0, -2.2, 1.1),
    size=vector(3, 1, 0.1),
    color=GREEN
)
spin_lbl = label(
    pos=vector(0, -2.2, 1.2),
    text="▶  SPIN", height=18, color=WHITE, box=False
)
msg_label = label(
    pos=vector(0, 3.2, 1.2),
    text="", height=16, color=GOLD, box=False
)

# ── 마우스 클릭 이벤트 ────────────────────────────────
def on_click(evt):
    global spinning, spin_time, credit, win_total, result
    obj = scene.mouse.pick
    if obj == spin_btn and not spinning and credit >= 1:
        credit    -= 1
        spinning   = True
        spin_time  = 0
        msg_label.text = ""
        result = [random.randint(0, len(SYMBOLS)-1) for _ in range(3)]
        credit_label.text = "CREDIT: " + str(credit)
        win_label.text    = "WIN: 0"

scene.bind('click', on_click)

# ── 메인 루프 ──────────────────────────────────────────
dt = 0.03
while True:
    rate(33)
    if spinning:
        spin_time += dt
        update_reels(final=False)   # 랜덤 심볼 회전 효과
        if spin_time >= spin_duration:
            spinning = False
            update_reels(final=True)  # 최종 심볼 고정
            prize = calc_prize(result)
            if prize > 0:
                credit    += prize
                win_total += prize
                win_label.text    = "WIN: " + str(prize)
                credit_label.text = "CREDIT: " + str(credit)
                if prize == 500:
                    msg_label.text = "🎉 JACKPOT !! 🎉"
                else:
                    msg_label.text = "✨ YOU WIN " + str(prize) + "!"
            else:
                msg_label.text = "TRY AGAIN..."
                win_label.text = "WIN: 0"
